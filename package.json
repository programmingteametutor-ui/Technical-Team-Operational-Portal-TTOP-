{
  "name": "interview-operations-portal",
  "version": "3.0.0",
  "private": true,
  "description": "One app for the TTOP and Call Pilots portals on Vercel + Supabase: one Google sign-in, one database (TTOP's tables), roles across both.",
  "main": "server/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "TZ=Asia/Kolkata node server/index.js",
    "check": "node scripts/check.js",
    "test": "node --test portals/ttop/test/*.test.js portals/callpilots/test/*.test.js test/*.test.js",
    "test:ttop": "node --test portals/ttop/test/*.test.js",
    "test:callpilots": "node --test portals/callpilots/test/*.test.js"
  },
  "dependencies": {
    "mysql2": "3.11.3",
    "web-push": "3.6.7"
  }
}
