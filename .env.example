# ===== Supabase: TTOP's existing project (Project Settings > API) =====
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# server only, never in the browser
SUPABASE_SERVICE_ROLE_KEY=

# ===== App =====
# (on Vercel PORT is not used; set these in Vercel > Settings > Environment Variables)
PORT=8080
# the address people open; add it in Supabase > Authentication > URL Configuration (Site URL + Redirect URLs)
PUBLIC_URL=https://portal.example.com
# long random text that signs the app's sign-in cookie (e.g. `openssl rand -hex 32`)
APP_SECRET=
# always super admins (comma-separated Google addresses); needed on a new database before Dhruva data exists
SUPER_ADMIN_EMAILS=
# hours before people must sign in again
APP_SESSION_HOURS=12
TZ=Asia/Kolkata

# ===== TTOP (same values it had on Vercel) =====
# scheduled Doc sync, Inbox fetch and phone alerts (pg_cron sends it as Bearer)
CRON_SECRET=
# TTOP_DOC_ID=18_X3ibtvERFdu1_A_LFIoB9_mU6DeR2EXguuOpJJsOo
# Interview Inbox: recruiter email database (SELECT-only login)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
INTERVIEW_IMPORT_START_DATE=2026-10-27
INBOX_DB_TIMEZONE=UTC
# phone alerts
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ===== Dhruva =====
# Owner of the old Apps Script deployment (Session.getEffectiveUser())
OWNER_EMAIL=owner@example.com
# Dhruva's sheet editor (/sheets): Dhruva roles allowed to edit sheet data
SHEET_EDITOR_ROLES=SUPER_ADMIN,ADMIN
# Worker threads per server copy for Dhruva's long operations (incentive scan, bulk approvals)
GAS_WORKERS=2
# A new server copy starts from a compressed snapshot of Dhruva's data in Supabase Storage
# (private bucket "app-snapshots", created automatically) plus the changes saved since.
# 0 = always read every row from the tables (slow start).
APP_SNAPSHOT=1
# Requests in parallel when reading the tables (no snapshot yet)
SUPABASE_LOAD_PARALLEL=8
# Milliseconds a server copy reuses its last check for other copies' changes (calls fired
# together by one page check once). Saves are still conflict-checked. 0 = check every call.
GAS_REFRESH_WINDOW_MS=1500
# Optional: Dhruva still sends email through MailApp in a few places (login codes are no longer used)
RESEND_API_KEY=
MAIL_FROM=

# ===== Shared candidates & clients =====
# Turn the sync on in the app (Shared candidates & clients). It runs from the
# once-a-minute job (supabase/app_schedule.sql).
